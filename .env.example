# Copy to .env and fill in. Never commit the real .env.
# MariaDB/MySQL. geoip/GeoLite2-City.mmdb is optional - see README.

# --- Core ---------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# True for local development. Must be False in production.
DEBUG=True

# Comma-separated. Add your own domain when deploying.
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated, and each entry needs the scheme (https://...).
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Public root of this install, no trailing slash. Payment gateway callback
# URLs are built from it, so it must be reachable by Pesapal/Daraja - use an
# ngrok or similar tunnel when testing payments locally.
BASE_URL=http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000

# Leave False for local development, or http:// requests get redirected to
# https:// and the site will appear to hang. True in production.
SECURE_SSL_REDIRECT=False

# --- Database (create it first: CREATE DATABASE tourismconference;) ------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Email --------------------------------------------------------------
# Leave EMAIL_* blank to skip email; the site runs without it, but
# registration and ticket mail will fail.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Payments -----------------------------------------------------------
# Optional for browsing the site; required to take payments. Get these from
# your own Pesapal and Safaricom Daraja dashboards.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_AUTH_URL=
PESAPAL_ORDER_URL=
PESAPAL_IPN_ID=
PESAPAL_ENVIRONMENT=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_INITIATE_URL=
DARAJA_TOKEN_URL=
DARAJA_ENVIRONMENT=
